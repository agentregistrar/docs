---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

// Prerender the 404 so it stays a static route under `output: "server"`.
// Hosts serve it via their not-found handling (e.g. Cloudflare
// `not_found_handling: "404-page"`); the adapter adds no on-demand route.
export const prerender = true;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const startHref = withBase("/start/", import.meta.env.BASE_URL);
const referenceHref = withBase("/reference/", import.meta.env.BASE_URL);
---

<BaseLayout title="not found" description="The page you are looking for does not exist." noindex>
  <div class="flex flex-col min-h-screen">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="flex-1 w-full mx-auto max-w-(--width-docs-article) px-4 py-24 md:px-6">
      <p class="text-xs uppercase tracking-wider text-faint">404</p>
      <h1 class="mt-2 text-2xl font-semibold leading-tight text-foreground">not found.</h1>
      <p class="mt-2 text-md leading-relaxed text-muted">
        The page you are looking for does not exist or has moved.
      </p>
      <nav aria-label="Recovery" class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-4 text-sm">
        <a href={homeHref} class="text-accent no-underline hover:underline">docs home</a>
        <a href={startHref} class="text-accent no-underline hover:underline">quickstarts</a>
        <a href={referenceHref} class="text-accent no-underline hover:underline">reference</a>
      </nav>
    </main>
    <Footer />
  </div>
</BaseLayout>
