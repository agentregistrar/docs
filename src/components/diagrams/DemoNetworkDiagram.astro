---
/**
 * Demo network diagrams for the public docs page.
 *
 * Two variants share one component so the page imports one file:
 * - `topology`: the 7-host open-source Demo Network (Hub/Workbench, Alpha,
 *   Beta, Directory, Reference, Federated, Unverified) and trust edges.
 * - `sequence`: the cross-broker signup and receipt-ingestion sequence between
 *   an agent, Sandbox Broker Alpha, Sandbox Broker Beta, and Federated Provider.
 *
 * Terminal rules: ASCII labels, 1px geometry, no icons, no gradients, no
 * shadows, no radius, tokens only. The viewBox is the narrowest rendered width
 * (about 318 CSS pixels), so text is not scaled below its authored size on a
 * phone. Not normative; the specification owns the contract.
 */
interface Props {
  variant?: "topology" | "sequence";
}

const { variant = "topology" } = Astro.props;
const isTopology = variant === "topology";
---

<figure class="my-6 border border-line bg-surface px-3 py-4">
  {
    isTopology ? (
      <svg
        viewBox="0 0 318 492"
        role="img"
        aria-labelledby="demo-topology-title"
        aria-describedby="demo-topology-desc"
        class="mx-auto block h-auto w-full"
        style="max-width: 30rem;"
      >
        <title id="demo-topology-title">7-host open-source demo network topology</title>
        <desc id="demo-topology-desc">
          The Demo Network has seven hosts isolated from production
          agentregistrar.dev. The Hub and Provider Workbench run at
          agentregistrardemobroker.com. Sandbox Broker Alpha at
          alpha.agentregistrardemobroker.com is the human/agent broker hosting
          the disposable 5-tool /mcp endpoint and issuing Contract A assertions
          and broker-managed attestations. Sandbox Broker Beta at
          beta.agentregistrardemobroker.com is an independent relying-party
          broker issuing provider-managed Contract G attestations. Under
          agentregistrardemorp.com, Reference Provider is Alpha-attested,
          Federated Provider is Beta-attested, Unverified Provider has no
          attestation, and the Demo RP Directory provides live status probes
          only.
        </desc>

        <g fill="var(--color-foreground)">
          <rect x="2" y="8" width="314" height="44" fill="none" stroke="var(--color-line)" />
          <text x="8" y="21" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">HUB &amp; PROVIDER WORKBENCH</text>
          <text x="8" y="34" font-size="10">agentregistrardemobroker.com</text>
          <text x="8" y="46" font-size="8" fill="var(--color-muted)">5-scenario Live Runner, Wire Inspector, /workbench</text>

          <rect x="2" y="62" width="314" height="54" fill="none" stroke="var(--color-line)" />
          <text x="8" y="76" font-size="10" letter-spacing="0.5" fill="var(--color-accent)">SANDBOX BROKER ALPHA</text>
          <text x="8" y="91" font-size="9">alpha.agentregistrardemobroker.com</text>
          <text x="8" y="106" font-size="8" fill="var(--color-muted)">disposable /mcp; Contract A assertions; broker attestations</text>

          <rect x="2" y="134" width="314" height="54" fill="none" stroke="var(--color-line)" />
          <text x="8" y="148" font-size="10" letter-spacing="0.5" fill="var(--color-muted)">SANDBOX BROKER BETA</text>
          <text x="8" y="163" font-size="9">beta.agentregistrardemobroker.com</text>
          <text x="8" y="178" font-size="8" fill="var(--color-muted)">independent RP broker; Contract G attestations, JWKS</text>

          <line x1="160" y1="116" x2="160" y2="130" stroke="var(--color-line-strong)" stroke-dasharray="3 3" />
          <polygon points="156,130 164,130 160,134" fill="var(--color-line-strong)" />
          <text x="168" y="128" font-size="8" fill="var(--color-warn)">Alpha trusts Beta</text>

          <rect x="56" y="206" width="250" height="52" fill="none" stroke="var(--color-line)" />
          <text x="62" y="220" font-size="10" letter-spacing="0.5" fill="var(--color-accent)">REFERENCE - ALPHA-ATTESTED</text>
          <text x="62" y="234" font-size="9">reference.agentregistrardemorp.com</text>
          <text x="62" y="247" font-size="8" fill="var(--color-muted)">aud demo-reference; mode broker; /api/login/agent</text>

          <rect x="56" y="272" width="250" height="52" fill="none" stroke="var(--color-line)" />
          <text x="62" y="286" font-size="10" letter-spacing="0.5" fill="var(--color-accent)">FEDERATED - BETA-ATTESTED</text>
          <text x="62" y="300" font-size="9">federated.agentregistrardemorp.com</text>
          <text x="62" y="313" font-size="8" fill="var(--color-muted)">aud demo-federated; mode provider; receipt to Alpha</text>

          <rect x="56" y="338" width="250" height="52" fill="none" stroke="var(--color-line)" />
          <text x="62" y="352" font-size="10" letter-spacing="0.5" fill="var(--color-warn)">UNVERIFIED - NO ATTESTATION</text>
          <text x="62" y="366" font-size="9">unverified.agentregistrardemorp.com</text>
          <text x="62" y="379" font-size="8" fill="var(--color-muted)">aud demo-unverified; tests verify/strict/no_verify</text>

          <text x="56" y="400" font-size="8" fill="var(--color-warn)">All 3 providers: issuer_allowlist = Alpha</text>

          <rect x="56" y="408" width="250" height="36" fill="none" stroke="var(--color-line)" />
          <text x="62" y="422" font-size="10" letter-spacing="0.5" fill="var(--color-muted)">DEMO RP DIRECTORY</text>
          <text x="62" y="436" font-size="9">agentregistrardemorp.com; status probes only</text>

          <line x1="20" y1="116" x2="20" y2="364" stroke="var(--color-line-strong)" />
          <line x1="20" y1="232" x2="52" y2="232" stroke="var(--color-line-strong)" />
          <line x1="20" y1="298" x2="52" y2="298" stroke="var(--color-line-strong)" />
          <line x1="20" y1="364" x2="52" y2="364" stroke="var(--color-line-strong)" />
          <polygon points="52,228 52,236 56,232" fill="var(--color-line-strong)" />
          <polygon points="52,294 52,302 56,298" fill="var(--color-line-strong)" />
          <polygon points="52,360 52,368 56,364" fill="var(--color-line-strong)" />
          <text x="24" y="200" font-size="8" fill="var(--color-muted)">assertions to RPs; receipts to Alpha</text>

          <line x1="310" y1="188" x2="310" y2="298" stroke="var(--color-line-strong)" stroke-dasharray="3 3" />
          <line x1="310" y1="298" x2="306" y2="298" stroke="var(--color-line-strong)" stroke-dasharray="3 3" />
          <polygon points="306,294 306,302 302,298" fill="var(--color-line-strong)" />
          <text x="218" y="267" font-size="8" fill="var(--color-warn)">Beta attestation</text>

          <line x1="8" y1="464" x2="28" y2="464" stroke="var(--color-line-strong)" />
          <text x="34" y="467" font-size="8" fill="var(--color-muted)">assertion or receipt</text>
          <line x1="150" y1="464" x2="170" y2="464" stroke="var(--color-line-strong)" stroke-dasharray="3 3" />
          <text x="176" y="467" font-size="8" fill="var(--color-muted)">attestation or trust</text>
          <text x="8" y="484" font-size="8" fill="var(--color-muted)">Isolated from production agentregistrar.dev; TTL cleanup.</text>
        </g>
      </svg>
    ) : (
      <svg
        viewBox="0 0 318 520"
        role="img"
        aria-labelledby="demo-sequence-title"
        aria-describedby="demo-sequence-desc"
        class="mx-auto block h-auto w-full"
        style="max-width: 30rem;"
      >
        <title id="demo-sequence-title">Cross-broker signup sequence with Alpha, Beta, and Federated Provider</title>
        <desc id="demo-sequence-desc">
          Ten events. The sandbox agent calls identity_signup at Broker Alpha
          for Federated Provider. Alpha fetches Federated discovery and Beta
          metadata and JWKS, caches them for at most five minutes, verifies the
          Beta Contract G attestation against the sandbox trust policy, and
          records the delegated acceptance. Alpha mints an assertion for
          demo-federated. The agent posts the assertion to Federated. Federated
          verifies it against Alpha JWKS and its issuer allowlist, checks the
          terms hash and creates an account. Federated signs a receipt with its
          Beta-attested key and posts the receipt and exact Beta attestation to
          Alpha. Alpha verifies the Beta attestation and key and records
          rp_callback. The agent may record the same receipt again and Alpha
          dedupes it as rp_signed. Broker Beta serves metadata, JWKS, and
          attestations only, never mints an assertion, and shares no account
          table with Alpha.
        </desc>

        <g fill="var(--color-foreground)">
          <rect x="2" y="8" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="17" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">AGENT</text>
          <text x="6" y="37" font-size="10" fill="var(--color-accent)">1</text>
          <text x="30" y="26" font-size="9">identity_signup at Alpha for Federated</text>
          <text x="30" y="39" font-size="9">with exact terms; Alpha is sole issuer</text>

          <rect x="2" y="52" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="61" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">BROKER ALPHA</text>
          <text x="6" y="81" font-size="10" fill="var(--color-accent)">2</text>
          <text x="30" y="70" font-size="9">fetch Federated discovery and Beta</text>
          <text x="30" y="83" font-size="9">metadata/JWKS (cache at most 5 minutes)</text>

          <rect x="2" y="96" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="105" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">BROKER ALPHA</text>
          <text x="6" y="125" font-size="10" fill="var(--color-accent)">3</text>
          <text x="30" y="114" font-size="9">verify Beta attestation against policy;</text>
          <text x="30" y="127" font-size="9">record the delegated acceptance</text>

          <rect x="2" y="140" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="149" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">BROKER ALPHA</text>
          <text x="6" y="169" font-size="10" fill="var(--color-accent)">4</text>
          <text x="30" y="158" font-size="9">mint Contract A assertion for</text>
          <text x="30" y="171" font-size="9">aud demo-federated</text>

          <rect x="2" y="184" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="193" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">AGENT</text>
          <text x="6" y="213" font-size="10" fill="var(--color-accent)">5</text>
          <text x="30" y="202" font-size="9">POST assertion to Federated as</text>
          <text x="30" y="215" font-size="9">Authorization: Bearer</text>

          <rect x="2" y="228" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="237" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">FEDERATED RP</text>
          <text x="6" y="257" font-size="10" fill="var(--color-accent)">6</text>
          <text x="30" y="246" font-size="9">verify Alpha JWKS and issuer_allowlist;</text>
          <text x="30" y="259" font-size="9">check ToS hash; create account</text>

          <rect x="2" y="272" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="281" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">FEDERATED RP</text>
          <text x="6" y="301" font-size="10" fill="var(--color-accent)">7</text>
          <text x="30" y="290" font-size="9">sign receipt with Beta-attested key;</text>
          <text x="30" y="303" font-size="9">post receipt + exact Beta attestation</text>

          <rect x="2" y="316" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="325" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">BROKER ALPHA</text>
          <text x="6" y="345" font-size="10" fill="var(--color-accent)">8</text>
          <text x="30" y="334" font-size="9">verify Beta attestation and RP key;</text>
          <text x="30" y="347" font-size="9">record proof_source rp_callback</text>

          <rect x="2" y="360" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="369" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">AGENT</text>
          <text x="6" y="389" font-size="10" fill="var(--color-accent)">9</text>
          <text x="30" y="378" font-size="9">identity_record_signup with the same</text>
          <text x="30" y="391" font-size="9">receipt; dedupe as rp_signed</text>

          <rect x="2" y="404" width="314" height="40" fill="none" stroke="var(--color-line)" />
          <text x="6" y="413" font-size="9" letter-spacing="0.5" fill="var(--color-muted)">BROKER BETA</text>
          <text x="6" y="433" font-size="10" fill="var(--color-accent)">10</text>
          <text x="30" y="422" font-size="9">metadata, JWKS and attestations only;</text>
          <text x="30" y="435" font-size="9">never mints a Contract A assertion</text>

          <line x1="8" y1="462" x2="28" y2="462" stroke="var(--color-line-strong)" />
          <text x="34" y="465" font-size="8" fill="var(--color-muted)">assertion or receipt</text>
          <line x1="160" y1="462" x2="180" y2="462" stroke="var(--color-line-strong)" stroke-dasharray="3 3" />
          <text x="186" y="465" font-size="8" fill="var(--color-muted)">attestation or trust</text>

          <text x="8" y="490" font-size="9" fill="var(--color-warn)">No account mesh: Alpha and Beta share no accounts.</text>
          <text x="8" y="506" font-size="9" fill="var(--color-muted)">Isolated from production agentregistrar.dev.</text>
        </g>
      </svg>
    )
  }
  <figcaption class="mt-3 text-xs text-faint">
    {
      isTopology
        ? "Figure 1. The 7-host open-source Demo Network: Hub/Workbench, Sandbox Brokers Alpha and Beta, Demo RP Directory, and three simulated providers. Solid edges carry Contract A assertions and receipts; dashed edges carry attestation trust or policy."
        : "Figure 2. Cross-broker signup: Alpha verifies Beta's Contract G attestation, Federated verifies Alpha's Contract A assertion, and Alpha ingests the Beta-attested receipt. Beta never mints an assertion and no account mesh exists."
    }
  </figcaption>
</figure>

<style>
  svg text {
    font-family: var(--font-mono);
  }
</style>
