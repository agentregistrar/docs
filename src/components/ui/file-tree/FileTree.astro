---
/**
 * FileTree - collapsible file/directory tree from a nested <ul>.
 *
 * Terminal style: bg-well, 1px line, ASCII +/- disclosure markers, no icons.
 * The client transforms the list into native <details>; behavior is unchanged.
 *
 * Usage:
 *   <FileTree>
 *   - src/
 *     - components/
 *       - **Header.astro**
 *       - Footer.astro
 *   - package.json
 *   </FileTree>
 *
 * Conventions:
 *   - Trailing `/` -> directory (collapsible)
 *   - `**name**` -> highlighted entry
 *   - `...` -> placeholder
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...attrs } = Astro.props;
---

<div class={cn("file-tree", className)} data-file-tree {...attrs}>
  <slot />
</div>

<style>
  .file-tree {
    margin: 1.5rem 0;
    border: 1px solid var(--color-line);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    background: var(--color-well);
  }

  .file-tree :global(p) { display: inline; margin: 0; }

  .file-tree :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.875rem;
  }

  .file-tree > :global(ul) { padding-left: 0; }

  .file-tree :global(ul ul) {
    border-left: 1px solid var(--color-line);
    margin-left: 0.25rem;
  }

  .file-tree :global(li) {
    margin: 0;
    padding-block: 0.0625rem;
    color: var(--color-foreground);
  }

  /* Prose list markers stop at the tree boundary. */
  .file-tree :global(li::before) {
    content: none;
    display: none;
  }

  .file-tree :global(details) { margin: 0; }

  .file-tree :global(summary) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.25rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 100ms;
  }

  .file-tree :global(summary::-webkit-details-marker) { display: none; }
  .file-tree :global(summary::marker) { display: none; content: ""; }

  .file-tree :global(summary:hover) {
    background: var(--color-hover);
  }

  .file-tree :global(summary::before) {
    content: "+";
    color: var(--color-faint);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .file-tree :global(details[open] > summary::before) {
    content: "-";
  }

  .file-tree :global([data-file]) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.25rem;
    cursor: default;
  }

  /* The client keeps these slots for layout; they stay empty and invisible. */
  .file-tree :global(.ft-chev),
  .file-tree :global(.ft-icon) {
    flex-shrink: 0;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* Invisible spacer - keeps files aligned with directory names. */
  .file-tree :global(.ft-sp) {
    flex-shrink: 0;
    width: 0.75rem;
  }

  .file-tree :global(.ft-label) {
    min-width: 0;
    white-space: nowrap;
  }

  .file-tree :global(strong) {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .file-tree :global([data-placeholder]) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.25rem;
    color: var(--color-muted);
    letter-spacing: 0.1em;
  }
</style>

<script>
  import "./file-tree.client";
</script>
