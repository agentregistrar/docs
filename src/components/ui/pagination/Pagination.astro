---
/**
 * Pagination - text-only previous/next row above a 1px rule.
 * ASCII arrows, no cards, no buttons.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import type { PrevNext } from "@cloudflare/nimbus-docs/types";
import { withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props extends HTMLAttributes<"nav"> {
  prevNext: PrevNext;
}

const { prevNext, class: className, ...attrs } = Astro.props;
const { prev, next } = prevNext;
const prevHref = prev ? withBase(prev.href, import.meta.env.BASE_URL) : undefined;
const nextHref = next ? withBase(next.href, import.meta.env.BASE_URL) : undefined;
---

{(prev || next) && (
  <nav aria-label="Pagination" class={cn("mt-12 flex items-start justify-between gap-4 border-t border-line pt-4", className)} {...attrs}>
    {prev ? (
      <a href={prevHref} class="group flex min-h-11 flex-col gap-1 text-sm text-muted no-underline transition-colors duration-100 hover:text-foreground">
        <span class="text-xs text-faint">&lt;- previous</span>
        <span class="font-medium text-foreground">{prev.label}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={nextHref} class="group flex min-h-11 flex-col items-end gap-1 text-right text-sm text-muted no-underline transition-colors duration-100 hover:text-foreground">
        <span class="text-xs text-faint">next -&gt;</span>
        <span class="font-medium text-foreground">{next.label}</span>
      </a>
    ) : <span />}
  </nav>
)}
