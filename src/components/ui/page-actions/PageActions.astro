---
/**
 * PageActions - text-only page utilities: updated timestamp, copy markdown,
 * view markdown. Issue 05 appends the `awaiting review` provenance label to
 * the same row (data-nb-review-status); this issue ships the styled surface.
 */
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
}

const { markdownUrl, lastUpdated, class: className, ...attrs } = Astro.props;
const resolvedMarkdownUrl = markdownUrl
  ? withBase(markdownUrl, import.meta.env.BASE_URL)
  : undefined;

const baseBtn =
  "inline-flex cursor-pointer items-center gap-1.5 border-0 bg-transparent px-0 py-0.5 text-muted no-underline transition-colors duration-100 hover:text-foreground focus-visible:outline-1 focus-visible:outline-accent focus-visible:outline-offset-2";

const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "2-digit", day: "2-digit" }).format(lastUpdated)
  : null;
---

{(resolvedMarkdownUrl || lastUpdated) && (
  <div
    data-nb-page-actions
    data-pagefind-ignore
    data-md-url={resolvedMarkdownUrl}
    class={cn("not-prose flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted", className)}
    {...attrs}
  >
    {lastUpdated && (
      <span class="inline-flex items-center gap-1.5 py-0.5 text-faint">
        updated <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </span>
    )}

    {resolvedMarkdownUrl && lastUpdated && (
      <span aria-hidden="true" class="select-none text-ghost">|</span>
    )}

    {resolvedMarkdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <span data-nb-page-actions-label aria-live="polite">copy markdown</span>
        </button>

        <span aria-hidden="true" class="select-none text-ghost">|</span>

        <a
          href={resolvedMarkdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={baseBtn}
        >
          view markdown -&gt;
        </a>
      </>
    )}
  </div>
)}

<script>
  import "./page-actions.client";
</script>
