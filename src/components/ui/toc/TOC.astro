---
/**
 * TOC - on-this-page nav with scroll-spy.
 *
 * The two rails are plain 1px borders (active heading = accent) and the
 * per-heading depth is padding, not an S-curve. Nimbus's client still owns the
 * scroll-spy and sets `aria-current` on the active link; its SVG rail stays in
 * the DOM for the client contract but is not rendered (see globals.css).
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import type { TOCItem } from "@cloudflare/nimbus-docs/types";

interface Props extends HTMLAttributes<"div"> {
  headings: TOCItem[];
}

const { headings, class: className, ...attrs } = Astro.props;
---

{headings.length > 0 && (
  <div data-nb-toc class={cn("toc-container", className)} {...attrs}>
    <h2 class="mb-2 text-xs font-medium uppercase tracking-wider text-faint">on this page</h2>
    <nav aria-label="Table of contents" class="relative">
      <svg data-nb-toc-rail aria-hidden="true" class="hidden" fill="none">
        <path data-nb-toc-rail-active stroke="currentColor" stroke-width="2" />
      </svg>

      <ul class="m-0 flex list-none flex-col p-0">
        {headings.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-nb-toc-link
              data-nb-slug={h.slug}
              class="block border-l-2 border-line py-1.5 pr-2 text-sm text-muted no-underline transition-colors duration-100 hover:border-line-strong hover:text-foreground aria-[current=true]:border-accent aria-[current=true]:font-medium aria-[current=true]:text-foreground"
              style={`padding-left: calc(0.625rem + ${Math.max(0, h.depth - 2)}rem);`}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
)}

<script>
  import "./toc.client";
</script>
