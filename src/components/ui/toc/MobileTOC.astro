---
/**
 * MobileTOC - compact "on this page" menu for narrow viewports.
 *
 * A native <select> whose options are the page headings, indented by depth.
 * The client mirrors the active heading back into the select value, so the
 * Nimbus scroll-spy behavior is unchanged; only the visuals are themed.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import type { TOCItem } from "@cloudflare/nimbus-docs/types";

interface Props extends HTMLAttributes<"nav"> {
  headings: TOCItem[];
}

const { headings, class: className, ...attrs } = Astro.props;

const hasHeadings = headings.length > 0;
---

{
  hasHeadings && (
    <nav data-nb-mobile-toc aria-label="On this page" class={cn("relative", className)} {...attrs}>
      <label class="mb-1 block text-xs uppercase tracking-wider text-faint" for="mobile-toc-select">
        on this page
      </label>
      <select
        id="mobile-toc-select"
        data-nb-mobile-toc-select
        aria-label="Jump to section"
        class="w-full border border-line-strong bg-well px-2 py-2 text-sm text-foreground transition-colors duration-100 focus-visible:border-accent focus-visible:outline-none"
      >
        <option value="_top">top</option>
        {headings.filter((heading) => heading.slug).map((heading) => (
          <option value={heading.slug}>
            {`${"\t".repeat(Math.max(0, heading.depth - 2))}${heading.text}`}
          </option>
        ))}
      </select>
    </nav>
  )
}

<script>
  import "./mobile-toc.client";
</script>
