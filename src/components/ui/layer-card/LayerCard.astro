---
/**
 * LayerCard - two-layer card (recessed header + content).
 * Terminal: 1px line, square, no shadow. The header uses the well fill.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** @default "vertical" */
  orientation?: "vertical" | "horizontal";
}

const { orientation = "vertical", class: className, ...attrs } = Astro.props;
---

<div
  data-orientation={orientation}
  class={cn(
    "group/layer flex w-full overflow-hidden border border-line bg-well text-sm",
    orientation === "horizontal" ? "flex-row items-stretch" : "flex-col",
    className,
  )}
  {...attrs}
>
  <slot />
</div>
