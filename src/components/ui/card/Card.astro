---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title: string;
}

const { title, class: className, ...attrs } = Astro.props;
---

<article class={cn("my-4 rounded-lg bg-card p-5 shadow-sm ring ring-border", className)} {...attrs}>
  <h3 class="m-0 text-base font-semibold leading-snug text-foreground">{title}</h3>
  <div class="mt-1.5 text-sm leading-normal text-muted-foreground">
    <slot />
  </div>
</article>
