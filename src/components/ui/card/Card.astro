---
/**
 * Card - a 1px rectangle: no shadow, no radius, no gradient.
 * Title 14/500, description 13/muted.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"article"> {
  title: string;
}

const { title, class: className, ...attrs } = Astro.props;
---

<article class={cn("my-4 border border-line bg-surface p-4 transition-colors duration-100 hover:border-line-strong", className)} {...attrs}>
  <h3 class="m-0 text-md font-medium leading-snug text-foreground">{title}</h3>
  <div class="mt-1 text-base leading-normal text-muted">
    <slot />
  </div>
</article>
