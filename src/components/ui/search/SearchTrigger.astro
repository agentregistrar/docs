---
/** Button that opens the search dialog. Ctrl+K on macOS, Ctrl+K elsewhere. */
---

<button
  data-search-trigger
  type="button"
  class="flex h-11 items-center gap-2 border border-line bg-background px-2 text-sm text-muted transition-colors duration-100 hover:border-line-strong hover:text-foreground md:h-8"
  aria-label="Search documentation"
  aria-keyshortcuts="Control+K"
>
  <span>search</span>
  <kbd class="hidden items-center gap-0.5 border border-line bg-well px-1 py-0.5 text-[10px] font-medium text-faint sm:inline-flex">
    <span data-shortcut-key>Ctrl</span>K
  </kbd>
</button>

<script>
  import "./search-trigger.client";
</script>
