---
import { Dialog, DialogClose, DialogContent } from "@/components/ui/dialog";
---

<Dialog aria-label="Search documentation" data-search-dialog>
  <DialogContent class="max-w-xl">
    <div class="flex flex-col overflow-hidden">
      <div class="flex items-center gap-3 border-b border-line px-3 py-2">
        <input
          data-search-input
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls="search-listbox"
          type="text"
          placeholder="search documentation..."
          class="min-h-11 min-w-0 flex-1 border-0 bg-transparent text-md text-foreground placeholder:text-ghost focus:outline-none"
          autocomplete="off"
          spellcheck="false"
          autocorrect="off"
          autocapitalize="none"
        />
        <DialogClose class="inline-flex min-h-11 min-w-11 items-center justify-center border border-line bg-transparent px-1.5 text-xs text-muted transition-colors duration-100 hover:border-line-strong hover:text-foreground md:min-h-6 md:min-w-6">
          esc
        </DialogClose>
      </div>

      <div class="min-h-40 overflow-y-auto p-1">
        <div data-search-results role="listbox" id="search-listbox" aria-orientation="vertical"></div>
        <p data-search-empty role="status" class="py-8 text-center text-sm text-muted">
          type to search.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-4 border-t border-line px-3 py-2 text-xs text-faint">
      <span>up/down navigate</span>
      <span>enter select</span>
      <span>esc close</span>
    </div>
  </DialogContent>
</Dialog>

<script>
  import "./search.client";
</script>
