---
/**
 * Banner - announcement strip. 1px structural border plus a 2px signal left
 * bar; a text `x` dismiss control, no icon. Dismiss persistence is unchanged.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** HTML, rendered as written: trusted like the rest of the site's content. */
  content: string;
  variant?: "note" | "tip" | "caution" | "danger";
  dismissible?: { id: string; days?: number };
}

const { content, variant = "note", dismissible, class: className, ...attrs } = Astro.props;

const config: Record<string, { label: string; signal: string }> = {
  note: { label: "[NOTE]", signal: "var(--color-muted)" },
  tip: { label: "[OK]", signal: "var(--color-accent)" },
  caution: { label: "[CAUTION]", signal: "var(--color-warn)" },
  danger: { label: "[ERROR]", signal: "var(--color-danger)" },
};

const c = config[variant] ?? config.note;
---

<div
  role={variant === "danger" || variant === "caution" ? "alert" : "status"}
  class={cn("banner-card my-4 flex w-full items-start gap-3 px-4 py-3 text-sm leading-normal text-foreground", className)}
  style={`--_signal: ${c.signal};`}
  {...(dismissible
    ? { "data-nb-banner-dismiss": dismissible.id, "data-nb-banner-days": dismissible.days }
    : {})}
  {...attrs}
>
  <div class="banner-card-body min-w-0 flex-1">
    <p class="m-0 mb-1 text-xs font-medium uppercase tracking-wider" style="color: var(--_signal)">{c.label}</p>
    <Fragment set:html={content} />
  </div>
  {dismissible && (
    <button
      type="button"
      data-nb-banner-close
      class="-my-1 -mr-2 flex h-7 shrink-0 items-center justify-center px-2 font-mono text-xs text-muted transition-colors duration-100 hover:text-foreground"
      aria-label="dismiss banner"
    >
      x
    </button>
  )}
</div>

<script>
  import "./banner.client";
</script>

<style>
  .banner-card {
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--_signal);
    background: var(--color-surface);
  }

  .banner-card-body { min-width: 0; overflow-wrap: break-word; }
  .banner-card-body :global(p) { margin: 0; }
  .banner-card-body :global(p + p) { margin-top: 0.375rem; }
  .banner-card-body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }
  .banner-card-body :global(a:hover) { text-decoration: underline; }

  .banner-card-body :global(code:not(:where(pre *))) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-well);
    border: 1px solid var(--color-line);
    padding: 0 0.25rem;
  }
</style>
