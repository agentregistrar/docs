---
/**
 * Aside - callout. 1px structural border plus a 2px signal left bar.
 * No background tint, no icon, no radius. The label is the signal word:
 *   [NOTE] muted | [OK] accent | [CAUTION] warn | [ERROR] danger
 * Nimbus's `<Aside type="...">` API and slot contract are unchanged.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"aside"> {
  // Uses `type` (not `variant`) to match the conventional <Aside type="..."> authoring API.
  type?: "note" | "tip" | "caution" | "danger";
  title?: string;
}

const { type = "note", title, class: className, ...attrs } = Astro.props;

const config: Record<string, { label: string; signal: string }> = {
  note: { label: "[NOTE]", signal: "var(--color-muted)" },
  tip: { label: "[OK]", signal: "var(--color-accent)" },
  caution: { label: "[CAUTION]", signal: "var(--color-warn)" },
  danger: { label: "[ERROR]", signal: "var(--color-danger)" },
};

const c = config[type] ?? config.note;
const displayTitle = title ?? c.label;
---

<aside
  role="note"
  aria-label={displayTitle}
  class={cn("aside-card my-4 flex items-start gap-3 px-4 py-3", className)}
  style={`--_signal: ${c.signal};`}
  {...attrs}
>
  <div class="flex min-w-0 flex-1 flex-col gap-1">
    <p class="m-0 text-xs font-medium uppercase tracking-wider" style="color: var(--_signal)">
      {c.label}{title ? ` | ${title}` : ""}
    </p>
    <div class="aside-card-body text-base leading-normal text-foreground">
      <slot />
    </div>
  </div>
</aside>

<style>
  .aside-card {
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--_signal);
    background: var(--color-surface);
  }

  .aside-card-body :global(p) { margin: 0; }
  .aside-card-body :global(p + p) { margin-top: 0.5rem; }
  .aside-card-body :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }
  .aside-card-body :global(a:hover) { text-decoration: underline; }

  .aside-card-body :global(code:not(:where(pre *))) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: var(--color-well);
    border: 1px solid var(--color-line);
    padding: 0 0.25rem;
  }
  .aside-card-body :global(strong) { font-weight: 600; color: inherit; }

  .aside-card-body :global(.astro-code) {
    margin: 0.75rem 0;
  }
</style>
