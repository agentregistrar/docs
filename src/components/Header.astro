---
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import Wordmark from "./Wordmark.astro";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * sections disclosure is hidden. Default `true`.
   */
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;

// Normalize trailing slash so nav links compare cleanly.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const homeHref = withBase("/", import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);

// Lowercase chrome labels; the docs tree itself is unchanged.
const primaryNav = [
  { label: "start", href: "/start/" },
  { label: "providers", href: "/providers/" },
  { label: "agents", href: "/agents/" },
  { label: "protocol", href: "/protocol/" },
  { label: "reference", href: "/reference/" },
];

const isActive = (href: string): boolean => {
  const path = href.replace(/\/$/, "") || "/";
  if (path === "/") return currentSlug === "/";
  return currentSlug === path || currentSlug.startsWith(`${path}/`);
};
---

<header class="sticky top-0 z-30 border-b border-line bg-background">
  <div class="mx-auto flex h-12 w-full max-w-(--width-docs) items-center justify-between gap-3 px-4 lg:px-6">
    <div class="flex min-w-0 items-center gap-3">
      <slot name="brand">
        <a href={homeHref} class="inline-flex min-h-11 shrink-0 items-center no-underline" aria-label="Agent Registrar docs home">
          <Wordmark />
          <span class="ml-2 text-sm text-faint" aria-hidden="true">/ docs</span>
        </a>
      </slot>

      <nav aria-label="Primary" class="ml-2 hidden items-center gap-4 border-l border-line pl-4 lg:flex">
        {primaryNav.map((item) => (
          <a
            href={resolveSectionHref(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "inline-flex min-h-11 min-w-11 items-center justify-center whitespace-nowrap text-sm no-underline transition-colors duration-100",
              isActive(item.href)
                ? "text-foreground"
                : "text-muted hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1">
      <slot name="actions" />
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <a
          href={config.github}
          target="_blank"
          rel="noopener"
          class="hidden min-h-11 items-center px-2 text-sm text-muted no-underline transition-colors duration-100 hover:text-foreground sm:inline-flex"
        >
          github
        </a>
      )}
      <a
        href="https://agentregistrar.dev"
        class="hidden min-h-11 items-center px-2 text-sm text-muted no-underline transition-colors duration-100 hover:text-foreground md:inline-flex"
      >
        agentregistrar.dev
      </a>
      {showSidebar && (
        <button
          type="button"
          data-menu-btn
          aria-label="open sections"
          class="flex min-h-11 items-center border border-line px-2 text-sm text-muted transition-colors duration-100 hover:border-line-strong hover:text-foreground lg:hidden"
        >
          sections
        </button>
      )}
    </div>
  </div>
</header>
