---
/**
 * Footer - one wrapping link row plus the copyright line.
 *
 * Mirrors the public-site footer (Deliverable 11): 1px top border, lowercase
 * links, no social icons, no columns. Year is fixed so static output is
 * deterministic.
 */
import Wordmark from "./Wordmark.astro";

const year = 2026;

const FOOTER_LINKS = [
  { label: "spec", href: "https://github.com/agentregistrar/spec" },
  { label: "registry", href: "https://github.com/agentregistrar/spec/tree/main/registry" },
  { label: "validator", href: "https://github.com/agentregistrar/spec/blob/main/validator.md" },
  { label: "security", href: "mailto:security@agentregistrar.dev" },
  { label: "license", href: "https://github.com/agentregistrar/docs/blob/main/LICENSE" },
  { label: "agentregistrar.dev", href: "https://agentregistrar.dev" },
] as const;
---

<footer class="border-t border-line">
  <div class="mx-auto w-full max-w-(--width-docs) px-4 py-5 lg:px-6">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <a href="/" class="text-sm no-underline" aria-label="Agent Registrar docs home">
        <Wordmark />
        <span class="ml-2 text-sm text-faint" aria-hidden="true">/ docs</span>
      </a>
      <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        {FOOTER_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-muted no-underline transition-colors duration-100 hover:text-foreground"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <p class="mt-4 border-t border-line pt-3 text-xs text-faint">
      (c) {year} Agent Registrar | documentation is Apache-2.0
    </p>
  </div>
</footer>
