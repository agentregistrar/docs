---
/**
 * DocsLayout - three-column docs layout.
 *
 * Named slots for overrides (all optional, defaults render otherwise):
 *   header, sidebar, toc, page-title, content-footer, pagination
 */
import BaseLayout from "./BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { Banner } from "@/components/ui/banner";
import { Sidebar, SidebarFilter } from "@/components/ui/sidebar";
import { TOC, MobileTOC } from "@/components/ui/toc";
import { Breadcrumbs } from "@/components/ui/breadcrumbs";
import { Pagination } from "@/components/ui/pagination";
import { ImageZoom } from "@/components/ui/image-zoom";
import { PageActions } from "@/components/ui/page-actions";
import { Badge } from "@/components/ui/badge";
import type { DocsPageProps } from "@cloudflare/nimbus-docs/types";
import { getVersionStatus, getVersionAlternates, withBase } from "@cloudflare/nimbus-docs/runtime";

type Props = DocsPageProps & { audience?: "human" | "agent" | "both" };

const { title, description, sidebar, headings, breadcrumbs, prevNext, mode = "doc", banner, head = [], searchable, noindex, markdownUrl, socialImage, lastUpdated, editUrl, draft, audience, collection, entryId } = Astro.props;

// `searchable` derives from `noindex` when omitted: a non-crawlable page is
// by default not in the site search either. Explicit `searchable: true`
// overrides for the edge case of "no search engines, yes internal search."
const effectiveSearchable = searchable ?? !noindex;
const isCustom = mode === "custom";

// `sidebar: false` / `tableOfContents: false` in frontmatter come through
// from the route as literal `false` (not coerced to `[]`). They drive
// per-column suppression - chrome, mobile dialog, header menu button.
// Custom pages render no sidebar, so they get no drawer or menu button.
const showSidebar = sidebar !== false && !isCustom;

// Versioning: per-page status drives Pagefind faceting, deprecation
// banner, and the data-pagefind-ignore exclusion for hidden versions.
const versionStatus = collection ? await getVersionStatus(collection) : null;
const versionAlternates = collection && entryId
  ? await getVersionAlternates(collection, entryId)
  : null;
const currentSiblingUrl = versionAlternates?.canonical?.url
  ? withBase(versionAlternates.canonical.url, import.meta.env.BASE_URL)
  : null;
const homeHref = withBase("/", import.meta.env.BASE_URL);

// Page-body attribute resolution:
//   - If the user opted out via `searchable: false` (or `noindex: true`
//     with no explicit override) -> ignore.
//   - If the page is in a hidden version -> ignore unconditionally
//     (hidden takes precedence; you can't index hidden content even
//     if the page frontmatter says searchable=true).
//   - Otherwise -> mark as a Pagefind body, plus emit per-version and
//     per-status filters so the search UI can scope by them.
const pagefindAttrs: Record<string, string> = {};
// The status filter rides its own element below: an inline `name:value` filter
// captures to the end of the string, so a second inline filter can't share the
// attribute (it would corrupt the version value to "v1, status:deprecated").
const pagefindDeprecated =
  effectiveSearchable && !versionStatus?.isHidden && Boolean(versionStatus?.isDeprecated);
if (!effectiveSearchable || versionStatus?.isHidden) {
  pagefindAttrs["data-pagefind-ignore"] = "";
} else {
  pagefindAttrs["data-pagefind-body"] = "";
  if (versionStatus) {
    pagefindAttrs["data-pagefind-filter"] = `version:${versionStatus.version}`;
  }
}

const hasHeader = Astro.slots.has("header");
const hasSidebar = Astro.slots.has("sidebar");
const hasToc = Astro.slots.has("toc");
const hasPageTitle = Astro.slots.has("page-title");
const hasContentFooter = Astro.slots.has("content-footer");
const hasPagination = Astro.slots.has("pagination");
---

<BaseLayout title={title} description={description} noindex={noindex || draft} markdownUrl={markdownUrl} socialImage={socialImage} lastUpdated={lastUpdated} head={head} collection={collection} entryId={entryId}>
  <div class="flex flex-col min-h-screen">
    {hasHeader ? <slot name="header" /> : <Header collection={collection} entryId={entryId} showSidebar={showSidebar} />}

    {isCustom ? (
      <main id="main-content" tabindex="-1" transition:name="nb-content" class="flex-1">
        <slot />
      </main>
    ) : (
      <div class="flex-1 mx-auto w-full max-w-(--width-docs)">
        {breadcrumbs && breadcrumbs.length > 0 && (
          <div class="px-4 pt-4 md:px-6">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )}
        <div class="flex">
          {showSidebar && (
            <aside id="desktop-sidebar" data-nb-desktop-sidebar class="hidden lg:flex w-(--nb-sidebar-width) shrink-0 border-r border-line bg-background sticky top-12 h-[calc(100vh-3rem)] flex-col relative">
              {/* One tree per page: this node moves into the mobile drawer
                  while it is open and comes back on close. It owns the
                  scroll, so open-group and scroll state follow it. */}
              <div data-nb-sidebar-tree class="flex-1 min-h-0 overflow-y-auto overscroll-contain">
                {hasSidebar ? (
                  <slot name="sidebar" />
                ) : (
                  <nav class="px-3 pb-12 pt-4" aria-label="Documentation">
                    <SidebarFilter />
                    <Sidebar items={sidebar} persist />
                  </nav>
                )}
              </div>
            </aside>
          )}

          {/* Sidebar state restore - sets open groups and scroll before
              the sidebar module loads so state survives navigation.
              The `aria-hidden` attribute keeps Astro from bundling this as a
              deferred module: it MUST stay inline to run before the disclosure
              mounts, else the first click sees stale state.
              Only emit when the sidebar is rendered; otherwise the script is
              dead code (the `desktop-sidebar` element doesn't exist). */}
          {showSidebar && (
          <script is:inline aria-hidden="true">
          (function () {
            function centerActive(sidebar, active) {
              const sr = sidebar.getBoundingClientRect();
              const ar = active.getBoundingClientRect();
              sidebar.scrollTop += ar.top - sr.top - sr.height / 2 + ar.height / 2;
            }

            function setGroupOpen(group, open) {
              group.open = open;
            }

            function restore() {
              try {
                const sidebar = document.querySelector("[data-nb-sidebar-tree]");
                if (!sidebar) return;
                const content = sidebar.querySelector("[data-nb-sidebar]");
                if (!content) return;

                // State saved for a different sidebar is ignored entirely.
                const raw = JSON.parse(sessionStorage.getItem("sidebar-state") || "null");
                const state = raw && content.dataset.nbSidebarHash === raw.hash ? raw : null;
                if (state) {
                  const groups = content.querySelectorAll("[data-nb-sidebar-group]");
                  for (let i = 0; i < groups.length; i++) {
                    if (typeof state.open[i] === "boolean") {
                      setGroupOpen(groups[i], state.open[i]);
                    }
                  }
                }

                const active = sidebar.querySelector("[aria-current='page']");
                if (active) {
                  let d = active.closest("[data-nb-sidebar-group]");
                  while (d) {
                    setGroupOpen(d, true);
                    d = d.parentElement && d.parentElement.closest("[data-nb-sidebar-group]");
                  }
                }

                // Scroll only applies while the tree is visible (the rail
                // on desktop); the drawer restores it again when it opens.
                if (sidebar.clientHeight === 0) return;
                if (state && typeof state.scroll === "number") {
                  sidebar.scrollTop = state.scroll;
                  if (active) {
                    const sr = sidebar.getBoundingClientRect();
                    const ar = active.getBoundingClientRect();
                    if (ar.top < sr.top || ar.bottom > sr.bottom) centerActive(sidebar, active);
                  }
                } else if (active) {
                  centerActive(sidebar, active);
                }
              } catch (_) {}
            }

            restore();
            if (!window.__nbSidebarRestoreBound) {
              window.__nbSidebarRestoreBound = true;
              document.addEventListener("astro:after-swap", restore);
            }
          })();
          </script>
          )}

          <main id="main-content" tabindex="-1" transition:name="nb-content" class="flex-1 min-w-0">
            <div class="mx-auto max-w-(--width-docs-article) px-4 pb-12 pt-6 md:px-6">
              {versionStatus?.isDeprecated && (
                <Banner
                  variant="caution"
                  content={
                    currentSiblingUrl
                      ? `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. The latest version of this page is at <a href="${currentSiblingUrl}">${currentSiblingUrl}</a>.`
                      : `This is the <strong>${versionStatus.version}</strong> version of the docs and is no longer maintained. See the <a href="${homeHref}">current docs</a> for up-to-date content.`
                  }
                />
              )}
              {banner && <Banner content={banner.content} variant={banner.type} dismissible={banner.dismissible} />}
              <div {...pagefindAttrs}>
                {pagefindDeprecated && <span hidden data-pagefind-filter="status:deprecated"></span>}
                {hasPageTitle ? (
                  <slot name="page-title" />
                ) : (
                  <Fragment>
                    <div class="mt-4 flex items-center gap-3 flex-wrap">
                      <h1 class="text-foreground mb-0 leading-tight [text-wrap:balance]" style={`font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)`}>{title}</h1>
                      {draft && <Badge text="Draft" variant="warning" size="medium" />}
                    </div>
                    {description && (
                      <p class="text-md text-muted leading-relaxed mt-2 mb-2 [text-wrap:pretty]">{description}</p>
                    )}
                    <PageActions markdownUrl={markdownUrl} lastUpdated={lastUpdated} class={description ? undefined : "mt-3"} />
                    {/* Issue 05 fills this surface with provenance. Structure only. */}
                    <p data-nb-review-status data-pagefind-ignore hidden class="mt-2 text-xs text-faint">awaiting review</p>
                    {headings !== false && headings.length > 0 && (
                      <div class="border-line bg-background sticky top-12 z-20 -mx-4 mt-3 border-y px-4 py-2 md:-mx-6 md:px-6 lg:hidden">
                        <MobileTOC headings={headings} />
                      </div>
                    )}
                    {(markdownUrl || audience === "human") && (
                      audience === "human" ? (
                        <div class="mt-3 mb-6 flex items-center gap-3" role="none">
                          <div class="h-px flex-1 bg-line"></div>
                          <span class="text-xs uppercase tracking-wider text-faint">for humans</span>
                          <div class="h-px flex-1 bg-line"></div>
                        </div>
                      ) : (
                        <div class="mt-3 mb-6 h-px w-full bg-line" role="none" />
                      )
                    )}
                    {!description && !markdownUrl && audience !== "human" && <div class="mb-4" />}
                  </Fragment>
                )}
                <article class="docs-content max-w-none">
                  <slot />
                </article>
                {hasContentFooter ? (
                  <slot name="content-footer" />
                ) : editUrl && (
                  <div class="mt-8 mb-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted">
                    <a href={editUrl} class="inline-flex min-h-11 items-center gap-1 text-muted hover:text-foreground transition-colors duration-100 no-underline md:min-h-6" target="_blank" rel="noopener">
                      edit page -> github
                    </a>
                    <a href="https://github.com/agentregistrar/docs/issues/new" class="inline-flex min-h-11 items-center gap-1 text-muted hover:text-foreground transition-colors duration-100 no-underline md:min-h-6" target="_blank" rel="noopener">
                      report issue
                    </a>
                  </div>
                )}
              </div>
              {hasPagination ? <slot name="pagination" /> : <Pagination prevNext={prevNext} />}
            </div>
          </main>

          {headings !== false && (hasToc || headings.length > 0) && (
            <aside data-nb-toc-scroll-host class="hidden lg:block w-(--nb-toc-width) shrink-0 border-l border-line sticky top-12 h-[calc(100vh-3rem)] overflow-y-auto">
              <div class="pb-8 pl-5 pr-4 pt-6">
                {hasToc ? <slot name="toc" /> : <TOC headings={headings} />}
              </div>
            </aside>
          )}
        </div>
        <Footer />
      </div>
    )}

  </div>

  <ImageZoom />

  {showSidebar && (
    /* Mobile sidebar - native <dialog> for free focus trap, escape, backdrop. */
    <dialog
      data-mobile-sidebar
      data-state="closed"
      class="group fixed inset-0 m-0 h-full w-full max-h-full max-w-full border-0 bg-transparent p-0 [&::backdrop]:bg-background"
      aria-label="Documentation sections"
    >
      <div data-mobile-sidebar-panel class="flex h-full w-(--nb-sidebar-width) max-w-[85vw] -translate-x-full flex-col border-r border-line bg-background group-data-[state=open]:translate-x-0">
        <div class="sticky top-0 z-[1] flex items-center justify-between border-b border-line bg-background px-4 py-1.5">
          <span class="text-sm font-medium text-foreground">sections</span>
          <button data-close-sidebar class="flex min-h-11 min-w-11 items-center justify-center px-2 text-sm text-muted hover:text-foreground transition-colors duration-100" aria-label="close sections">
            close
          </button>
        </div>
        {/* The rail's tree is moved here while the drawer is open. */}
        <div data-nb-sidebar-drawer-slot class="flex min-h-0 flex-1 flex-col [&>[data-nb-sidebar-tree]]:min-h-0 [&>[data-nb-sidebar-tree]]:flex-1 [&>[data-nb-sidebar-tree]]:overflow-y-auto [&>[data-nb-sidebar-tree]]:overscroll-contain"></div>
      </div>
    </dialog>
  )}

  <script>
    import { mount, lockScroll, unlockScroll, generateId } from "@cloudflare/nimbus-docs/client";

    const CLOSE_DURATION_MS = 0;
    const DESKTOP_QUERY = "(min-width: 64rem)";

    // mount() re-binds on every astro:page-load and tears down on
    // astro:before-swap, so the hamburger survives client-side navigation.
    mount("[data-mobile-sidebar]", (root) => {
      const trigger = document.querySelector<HTMLElement>("[data-menu-btn]");
      if (!(root instanceof HTMLDialogElement) || !trigger) return () => {};
      const dialog = root;

      const controller = new AbortController();
      const { signal } = controller;
      let closeTimer: ReturnType<typeof setTimeout> | undefined;

      const prefersReducedMotion = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!dialog.id) dialog.id = generateId("nb-mobile-sidebar");
      trigger.setAttribute("aria-controls", dialog.id);
      trigger.setAttribute("aria-expanded", "false");
      if (!trigger.hasAttribute("aria-haspopup")) trigger.setAttribute("aria-haspopup", "dialog");

      const clearTimer = () => {
        if (closeTimer) {
          clearTimeout(closeTimer);
          closeTimer = undefined;
        }
      };

      // One tree per page: the drawer borrows the rail's tree node while it
      // is open and returns it on close, so markup renders once and open
      // groups, the filter, and scroll state stay with the reader. The
      // sidebar script restores the scroll whenever the tree is revealed.
      const tree = document.querySelector<HTMLElement>("[data-nb-sidebar-tree]");
      const rail = tree?.parentElement ?? null;
      const drawerSlot = dialog.querySelector<HTMLElement>("[data-nb-sidebar-drawer-slot]");
      const moveTreeToDrawer = () => {
        if (tree && drawerSlot && tree.parentElement !== drawerSlot) drawerSlot.append(tree);
      };
      const moveTreeToRail = () => {
        if (tree && rail && tree.parentElement !== rail) rail.prepend(tree);
      };

      const openSidebar = () => {
        clearTimer();
        if (dialog.open) {
          // Reclaim a drawer caught mid-slide-out rather than stranding it open.
          if (dialog.dataset.state === "closing") dialog.dataset.state = "open";
          return;
        }

        moveTreeToDrawer();
        dialog.showModal();
        dialog.dataset.state = "closed";
        lockScroll();
        trigger.setAttribute("aria-expanded", "true");

        // Flush the closed transform, then open in the same tick so the slide
        // starts on the next frame (a double rAF delays it by two frames).
        void dialog.offsetWidth;
        dialog.dataset.state = "open";

        dialog.querySelector<HTMLElement>("[data-close-sidebar]")?.focus({ preventScroll: true });
      };

      // Immediate close (no slide-out): reduced motion, or the viewport reaching desktop.
      const closeNow = () => {
        if (!dialog.open) return;
        clearTimer();
        dialog.close();
      };

      const closeSidebar = () => {
        if (!dialog.open || dialog.dataset.state === "closing") return;
        if (prefersReducedMotion()) {
          closeNow();
          return;
        }
        dialog.dataset.state = "closing";
        closeTimer = setTimeout(() => dialog.close(), CLOSE_DURATION_MS);
      };

      trigger.addEventListener("click", openSidebar, { signal });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeSidebar();
      }, { signal });

      // Fires for Escape, close button, backdrop, and closeNow() - cleanup in one place.
      dialog.addEventListener("close", () => {
        clearTimer();
        dialog.dataset.state = "closed";
        moveTreeToRail();
        unlockScroll();
        trigger.setAttribute("aria-expanded", "false");
        trigger.focus();
      }, { signal });

      dialog.querySelectorAll<HTMLElement>("[data-close-sidebar]")
        .forEach((el) => el.addEventListener("click", closeSidebar, { signal }));

      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) closeSidebar();
      }, { signal });

      // The hamburger is hidden past the desktop breakpoint; dismiss an open
      // drawer so it can't strand focus once its trigger disappears.
      const mql = window.matchMedia(DESKTOP_QUERY);
      mql.addEventListener("change", (event) => {
        if (event.matches) closeNow();
      }, { signal });
      if (mql.matches) closeNow();

      return () => {
        controller.abort();
        clearTimer();
        moveTreeToRail();
        trigger.setAttribute("aria-expanded", "false");
        // A swap while open never fires `close`; balance the scroll lock.
        if (dialog.open) unlockScroll();
      };
    });
  </script>

</BaseLayout>
