---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-700.css";
import "../styles/globals.css";
import "../styles/prose.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  getCollectionLlmsUrl,
  getVersionStatus,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import WebMCP from "@/components/WebMCP.astro";
import type { BasePageProps } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps;

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  socialImageSize,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
} = Astro.props;

const lang = config.locale ?? "en";
// Per-page agent-index pointer. For pages in non-primary or version
// collections, this resolves to `/<prefix>/llms.txt` (e.g. `/v0/llms.txt`
// for a v0 docs page, `/blog/llms.txt` for a blog post). Falls back to
// the root `/llms.txt` when no collection is provided.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = collection
  ? await getCollectionLlmsUrl(collection)
  : "/llms.txt";
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = withBase(llmsIndexPath, baseUrl);
const llmsUrl = Astro.site
  ? new URL(basedLlmsUrl, Astro.site).href
  : basedLlmsUrl;
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <WebMCP />


    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      socialImageSize={socialImageSize}
      lastUpdated={lastUpdated}
      head={pageHead}
      collection={collection}
      entryId={entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-100 focus:border focus:border-foreground focus:bg-foreground focus:px-3 focus:py-1 focus:text-sm focus:font-medium focus:text-background focus:no-underline"
    >
      skip to content
    </a>
    {!isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl ?? null} llmsUrl={llmsUrl} />
    )}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { mount, headingAnchors } from "@cloudflare/nimbus-docs/client";
      headingAnchors();

      // Text-only copy button. Nimbus ships an icon version; the Terminal
      // identity forbids icon glyphs, so the starter behavior is kept with a
      // text label and a header row on untitled blocks.
      mount("pre.astro-code", (pre) => {
        if (!(pre instanceof HTMLElement)) return () => {};
        if (pre.closest("[data-cg-panels-raw], [data-cg-row]")) return () => {};

        const figure = pre.closest<HTMLElement>(".nb-code-figure");
        const host = figure ?? pre;
        let bar: HTMLElement | null = null;
        let createdAtBar = false;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "nb-code-copy";
        button.textContent = "Copy";
        button.setAttribute("aria-label", "Copy code to clipboard");

        // Titled blocks already have a header row; untitled blocks get one so
        // every block shows its language label and the copy affordance.
        const titled = host.querySelector<HTMLElement>(".nb-code-title");
        if (titled) {
          titled.appendChild(button);
        } else if (figure) {
          bar = document.createElement("div");
          bar.className = "nb-code-bar";
          const label = document.createElement("span");
          label.className = "nb-code-bar-label";
          const lang = figure.dataset.nbLang ?? pre.dataset.nbLang ?? "text";
          label.textContent =
            lang && !["text", "plaintext", "plain", "txt"].includes(lang)
              ? lang
              : "code";
          bar.appendChild(label);
          bar.appendChild(button);
          figure.insertBefore(bar, pre);
          createdAtBar = true;
        } else {
          host.style.position = "relative";
          host.appendChild(button);
        }

        let resetTimer: number | undefined;

        const handleClick = async () => {
          const text = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            return;
          }
          button.textContent = "Copied";
          button.dataset.state = "copied";
          button.setAttribute("aria-label", "Copied");
          if (resetTimer) window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            button.textContent = "Copy";
            delete button.dataset.state;
            button.setAttribute("aria-label", "Copy code to clipboard");
          }, 1500);
        };

        button.addEventListener("click", handleClick);

        return () => {
          if (resetTimer) window.clearTimeout(resetTimer);
          button.removeEventListener("click", handleClick);
          button.remove();
          if (createdAtBar && bar) bar.remove();
        };
      });
    </script>
  </body>
</html>
